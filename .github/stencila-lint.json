{
  "problemMatcher": [
    {
      "owner": "stencila-lint",
      "pattern": [
        {
          "regexp": "^.*?(Error|Warning|Advice):(.*)$",
          "severity": 1,
          "message": 2
        },
        {
          "regexp": "^.*?\\[[^\\w]*([^:]+):(\\d+):(\\d+)(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    }
  ]
}
