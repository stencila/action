{
  "name": "stencila-action",
  "version": "0.3.3",
  "description": "GitHub Action to setup and use Stencila CLI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "fix": "eslint src --fix",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "build": "ncc build src/index.js -o dist --source-map --license licenses.txt",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stencila/action.git"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "Stencila",
    "CLI"
  ],
  "author": "Stencila",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/artifact": "^2.3.2",
    "@actions/cache": "^4.0.5",
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.1",
    "@actions/glob": "^0.5.0",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@stylistic/eslint-plugin": "^5.2.3",
    "@types/node": "^22.10.5",
    "@vercel/ncc": "^0.45.0",
    "c8": "^10.1.3",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
