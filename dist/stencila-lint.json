{
  "problemMatcher": [
    {
      "owner": "stencila-lint",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^.*?\\[[^\\w]*([^:]+):(\\d+):(\\d+)(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    }
  ]
}
